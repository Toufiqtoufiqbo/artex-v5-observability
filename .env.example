# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 出站目标约束（仅由运维配置，不能通过 UI/API 修改）
# LLM 连接测试只发往这里显式列出的主机；留空则所有连接测试都会被拒绝。
# 显式列出 loopback/私有地址（如 127.0.0.1:8899）是运维为本地中继做的明确选择；
# 未列出的本地/私有地址仍会拒绝。元数据地址/名称（169.254.169.254、
# metadata.google.internal 等）永远不允许，即使写入本列表。
# ARTEX_LLM_BASE_URL 不会自动授信；其派生主机仅在没有显式列表时兜底，且会丢弃本地/私有/元数据地址。
# 自定义工具 HTTP 试运行同理；留空则拒绝所有 HTTP 试运行。
ARTEX_TRUSTED_PROVIDER_HOSTS=
ARTEX_CUSTOM_TOOL_HTTP_TEST_HOSTS=
# 远程 MCP（http/sse）允许的主机，格式 host 或 host:port，逗号分隔。
ARTEX_MCP_ALLOWED_HOSTS=
# 仅对这些主机跳过 TLS 证书校验（自签证书场景）；其他主机的 insecure 请求会被忽略。
ARTEX_MCP_INSECURE_HOSTS=
