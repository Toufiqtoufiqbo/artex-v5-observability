# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 出站目标约束（仅由运维配置，不能通过 UI/API 修改）
# LLM 连接测试只发往这里显式列出的主机；留空则所有连接测试都会被拒绝。
# 自定义工具 HTTP 试运行同理；留空则拒绝所有 HTTP 试运行。
ARTEX_TRUSTED_PROVIDER_HOSTS=
ARTEX_CUSTOM_TOOL_HTTP_TEST_HOSTS=
# 远程 MCP（http/sse）允许的主机，格式 host 或 host:port，逗号分隔。
ARTEX_MCP_ALLOWED_HOSTS=
# 仅对这些主机跳过 TLS 证书校验（自签证书场景）；其他主机的 insecure 请求会被忽略。
ARTEX_MCP_INSECURE_HOSTS=
